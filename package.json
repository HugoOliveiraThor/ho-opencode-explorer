{
  "name": "ho-opencode-explorer",
  "displayName": "HO OpenCode Explorer",
  "description": "Browse and manage OpenCode skills, commands, agents, MCP servers, and prompts directly from the VS Code sidebar",
  "version": "0.3.0",
  "publisher": "ho",
  "license": "MIT",
  "icon": "resources/icon.png",
  "keywords": [
    "opencode",
    "open-code",
    "ai",
    "skills",
    "agents",
    "mcp",
    "mcp-servers",
    "prompts",
    "commands",
    "sidebar",
    "explorer"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/HugoOliveiraThor/ho-opencode-explorer"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:ho-opencode-explorer-main"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ho-opencode-explorer",
          "title": "HO OpenCode Explorer",
          "icon": "$(hubot)"
        },
        {
          "id": "ho-opencode-health",
          "title": "HO OpenCode Health",
          "icon": "$(heart)"
        }
      ]
    },
    "views": {
      "ho-opencode-explorer": [
        {
          "id": "ho-opencode-explorer-main",
          "name": "OpenCode Explorer"
        },
        {
          "id": "ho-opencode-detail",
          "name": "Details",
          "type": "webview"
        }
      ],
      "ho-opencode-health": [
        {
          "id": "ho-opencode-health-main",
          "name": "Health"
        }
      ]
    },
    "commands": [
      {
        "command": "_ho-opencode-explorer.checkForUpdates#sideBar",
        "title": "Check for Updates",
        "category": "HO OpenCode Explorer",
        "icon": "$(cloud-download)"
      },
      {
        "command": "_ho-opencode-explorer.refreshSkills#sideBar",
        "title": "Refresh Skills",
        "category": "HO OpenCode Explorer",
        "icon": "$(refresh)"
      },
      {
        "command": "_ho-opencode-explorer.refreshCommands#sideBar",
        "title": "Refresh Commands",
        "category": "HO OpenCode Explorer",
        "icon": "$(refresh)"
      },
      {
        "command": "_ho-opencode-explorer.openSkill#sideBar",
        "title": "Open SKILL.md",
        "category": "HO OpenCode Explorer",
        "icon": "$(go-to-file)"
      },
      {
        "command": "_ho-opencode-explorer.openCommand#sideBar",
        "title": "Open Command File",
        "category": "HO OpenCode Explorer",
        "icon": "$(go-to-file)"
      },
      {
        "command": "_ho-opencode-explorer.openAgent#sideBar",
        "title": "Open Agent Source",
        "category": "HO OpenCode Explorer",
        "icon": "$(go-to-file)"
      },
      {
        "command": "_ho-opencode-explorer.openMcp#sideBar",
        "title": "Open MCP Config",
        "category": "HO OpenCode Explorer",
        "icon": "$(go-to-file)"
      },
      {
        "command": "_ho-opencode-explorer.openPrompt#sideBar",
        "title": "Open Prompt File",
        "category": "HO OpenCode Explorer",
        "icon": "$(go-to-file)"
      },
      {
        "command": "_ho-opencode-explorer.newSkill#sideBar",
        "title": "New Skill",
        "category": "HO OpenCode Explorer",
        "icon": "$(new-file)"
      },
      {
        "command": "_ho-opencode-explorer.newCommand#sideBar",
        "title": "New Command",
        "category": "HO OpenCode Explorer",
        "icon": "$(new-file)"
      },
      {
        "command": "_ho-opencode-explorer.moveSkill#sideBar",
        "title": "Move Skill",
        "category": "HO OpenCode Explorer",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "_ho-opencode-explorer.moveCommand#sideBar",
        "title": "Move Command",
        "category": "HO OpenCode Explorer",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "_ho-opencode-explorer.hideSkill#sideBar",
        "title": "Hide Skill",
        "category": "HO OpenCode Explorer",
        "icon": "$(eye-closed)"
      },
      {
        "command": "_ho-opencode-explorer.showHiddenSkills#sideBar",
        "title": "Show Hidden Skills",
        "category": "HO OpenCode Explorer",
        "icon": "$(eye)"
      },
      {
        "command": "_ho-opencode-explorer.openHealthIssue#sideBar",
        "title": "Open File",
        "category": "HO OpenCode Health",
        "icon": "$(go-to-file)"
      },
      {
        "command": "_ho-opencode-explorer.createMissingHealthFile#sideBar",
        "title": "Create Missing File",
        "category": "HO OpenCode Health",
        "icon": "$(new-file)"
      },
      {
        "command": "_ho-opencode-explorer.refreshHealth#sideBar",
        "title": "Refresh Health",
        "category": "HO OpenCode Health",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "_ho-opencode-explorer.checkForUpdates#sideBar",
          "when": "view == ho-opencode-explorer-main",
          "group": "navigation"
        },
        {
          "command": "_ho-opencode-explorer.refreshSkills#sideBar",
          "when": "view == ho-opencode-explorer-main",
          "group": "navigation@1"
        },
        {
          "command": "_ho-opencode-explorer.refreshCommands#sideBar",
          "when": "view == ho-opencode-explorer-main",
          "group": "navigation@2"
        },
        {
          "command": "_ho-opencode-explorer.newSkill#sideBar",
          "when": "view == ho-opencode-explorer-main",
          "group": "navigation@3"
        },
        {
          "command": "_ho-opencode-explorer.newCommand#sideBar",
          "when": "view == ho-opencode-explorer-main",
          "group": "navigation@4"
        },
        {
          "command": "_ho-opencode-explorer.showHiddenSkills#sideBar",
          "when": "view == ho-opencode-explorer-main",
          "group": "navigation@5"
        },
        {
          "command": "_ho-opencode-explorer.refreshHealth#sideBar",
          "when": "view == ho-opencode-health-main",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "_ho-opencode-explorer.openSkill#sideBar",
          "when": "view == ho-opencode-explorer-main && viewItem == skill",
          "group": "inline"
        },
        {
          "command": "_ho-opencode-explorer.openCommand#sideBar",
          "when": "view == ho-opencode-explorer-main && viewItem == command",
          "group": "inline"
        },
        {
          "command": "_ho-opencode-explorer.openAgent#sideBar",
          "when": "view == ho-opencode-explorer-main && viewItem == agent",
          "group": "inline"
        },
        {
          "command": "_ho-opencode-explorer.openMcp#sideBar",
          "when": "view == ho-opencode-explorer-main && viewItem == mcp",
          "group": "inline"
        },
        {
          "command": "_ho-opencode-explorer.openPrompt#sideBar",
          "when": "view == ho-opencode-explorer-main && viewItem == prompt",
          "group": "inline"
        },
        {
          "command": "_ho-opencode-explorer.moveSkill#sideBar",
          "when": "view == ho-opencode-explorer-main && viewItem == skill",
          "group": "navigation"
        },
        {
          "command": "_ho-opencode-explorer.moveCommand#sideBar",
          "when": "view == ho-opencode-explorer-main && viewItem == command",
          "group": "navigation"
        },
        {
          "command": "_ho-opencode-explorer.hideSkill#sideBar",
          "when": "view == ho-opencode-explorer-main && viewItem == skill",
          "group": "navigation@1"
        },
        {
          "command": "_ho-opencode-explorer.openHealthIssue#sideBar",
          "when": "view == ho-opencode-health-main && viewItem == issue",
          "group": "inline"
        },
        {
          "command": "_ho-opencode-explorer.createMissingHealthFile#sideBar",
          "when": "view == ho-opencode-health-main && viewItem == issue",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "node esbuild.config.js",
    "watch": "node esbuild.config.js --watch",
    "package": "node esbuild.config.js --production",
    "lint": "eslint src",
    "format": "prettier --write 'src/**/*.ts'",
    "test": "vscode-test",
    "compile-tests": "tsc -p tsconfig.test.json",
    "pretest": "npm run compile && npm run compile-tests",
    "typecheck": "tsc --noEmit",
    "release": "standard-version",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^19.0.0",
    "@eslint/js": "^9.39.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/semver": "^7.7.1",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "commitlint": "^19.0.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.0.0",
    "glob": "^13.0.6",
    "husky": "^9.0.0",
    "mocha": "^10.8.0",
    "prettier": "^3.4.0",
    "standard-version": "^9.5.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "semver": "^7.6.0",
    "yaml": "^2.7.0"
  },
  "overrides": {
    "serialize-javascript": "7.1.0"
  },
  "standard-version": {
    "types": [
      {
        "type": "feat",
        "section": "Features"
      },
      {
        "type": "fix",
        "section": "Bug Fixes"
      },
      {
        "type": "perf",
        "section": "Performance"
      },
      {
        "type": "refactor",
        "section": "Refactoring"
      },
      {
        "type": "docs",
        "section": "Documentation"
      },
      {
        "type": "test",
        "section": "Tests"
      },
      {
        "type": "ci",
        "section": "CI"
      },
      {
        "type": "build",
        "section": "Build"
      },
      {
        "type": "chore",
        "section": "Chores"
      },
      {
        "type": "style",
        "section": "Style"
      },
      {
        "type": "revert",
        "section": "Reverts"
      }
    ]
  }
}
