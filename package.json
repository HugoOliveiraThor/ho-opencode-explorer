{
  "name": "ho-opencode-explorer",
  "displayName": "HO OpenCode Explorer",
  "description": "Browse and manage OpenCode skills and commands in VS Code sidebar",
  "version": "0.1.0",
  "publisher": "ho",
  "license": "MIT",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/ho/ho-opencode-explorer"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:ho-opencode-skills",
    "onView:ho-opencode-commands"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ho-opencode-explorer",
          "title": "HO OpenCode Explorer",
          "icon": "$(hubot)"
        }
      ]
    },
    "views": {
      "ho-opencode-explorer": [
        {
          "id": "ho-opencode-skills",
          "name": "Skills"
        },
        {
          "id": "ho-opencode-commands",
          "name": "Commands"
        },
        {
          "id": "ho-opencode-agents",
          "name": "Agents"
        },
        {
          "id": "ho-opencode-mcp",
          "name": "MCP Servers"
        },
        {
          "id": "ho-opencode-prompts",
          "name": "Prompts & Instructions"
        },
        {
          "id": "ho-opencode-detail",
          "name": "Details",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "_ho-opencode-explorer.checkForUpdates#sideBar",
        "title": "Check for Updates",
        "category": "HO OpenCode Explorer",
        "icon": "$(refresh)"
      },
      {
        "command": "_ho-opencode-explorer.refreshSkills#sideBar",
        "title": "Refresh Skills",
        "category": "HO OpenCode Explorer",
        "icon": "$(refresh)"
      },
      {
        "command": "_ho-opencode-explorer.refreshCommands#sideBar",
        "title": "Refresh Commands",
        "category": "HO OpenCode Explorer",
        "icon": "$(refresh)"
      },
      {
        "command": "_ho-opencode-explorer.openSkill#sideBar",
        "title": "Open SKILL.md",
        "category": "HO OpenCode Explorer",
        "icon": "$(go-to-file)"
      },
      {
        "command": "_ho-opencode-explorer.openCommand#sideBar",
        "title": "Open Command File",
        "category": "HO OpenCode Explorer",
        "icon": "$(go-to-file)"
      },
      {
        "command": "_ho-opencode-explorer.openAgent#sideBar",
        "title": "Open Agent Source",
        "category": "HO OpenCode Explorer",
        "icon": "$(go-to-file)"
      },
      {
        "command": "_ho-opencode-explorer.openMcp#sideBar",
        "title": "Open MCP Config",
        "category": "HO OpenCode Explorer",
        "icon": "$(go-to-file)"
      },
      {
        "command": "_ho-opencode-explorer.openPrompt#sideBar",
        "title": "Open Prompt File",
        "category": "HO OpenCode Explorer",
        "icon": "$(go-to-file)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "_ho-opencode-explorer.checkForUpdates#sideBar",
          "when": "view == ho-opencode-skills",
          "group": "navigation"
        },
        {
          "command": "_ho-opencode-explorer.refreshSkills#sideBar",
          "when": "view == ho-opencode-skills",
          "group": "navigation"
        },
        {
          "command": "_ho-opencode-explorer.checkForUpdates#sideBar",
          "when": "view == ho-opencode-commands",
          "group": "navigation"
        },
        {
          "command": "_ho-opencode-explorer.refreshCommands#sideBar",
          "when": "view == ho-opencode-commands",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "_ho-opencode-explorer.openSkill#sideBar",
          "when": "view == ho-opencode-skills && viewItem == skill",
          "group": "inline"
        },
        {
          "command": "_ho-opencode-explorer.openCommand#sideBar",
          "when": "view == ho-opencode-commands && viewItem == command",
          "group": "inline"
        },
        {
          "command": "_ho-opencode-explorer.openAgent#sideBar",
          "when": "view == ho-opencode-agents && viewItem == agent",
          "group": "inline"
        },
        {
          "command": "_ho-opencode-explorer.openMcp#sideBar",
          "when": "view == ho-opencode-mcp && viewItem == mcp",
          "group": "inline"
        },
        {
          "command": "_ho-opencode-explorer.openPrompt#sideBar",
          "when": "view == ho-opencode-prompts && viewItem == prompt",
          "group": "inline"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "node esbuild.config.js",
    "watch": "node esbuild.config.js --watch",
    "package": "node esbuild.config.js --production",
    "lint": "eslint src",
    "format": "prettier --write 'src/**/*.ts'",
    "test": "vscode-test",
    "compile-tests": "tsc -p tsconfig.test.json",
    "pretest": "npm run compile && npm run compile-tests",
    "typecheck": "tsc --noEmit",
    "release": "standard-version",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^19.0.0",
    "@eslint/js": "^9.39.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/semver": "^7.7.1",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "commitlint": "^19.0.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.0.0",
    "glob": "^13.0.6",
    "husky": "^9.0.0",
    "mocha": "^10.8.0",
    "prettier": "^3.4.0",
    "standard-version": "^9.5.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "semver": "^7.6.0",
    "yaml": "^2.7.0"
  },
  "standard-version": {
    "types": [
      { "type": "feat", "section": "Features" },
      { "type": "fix", "section": "Bug Fixes" },
      { "type": "perf", "section": "Performance" },
      { "type": "refactor", "section": "Refactoring" },
      { "type": "docs", "section": "Documentation" },
      { "type": "test", "section": "Tests" },
      { "type": "ci", "section": "CI" },
      { "type": "build", "section": "Build" },
      { "type": "chore", "section": "Chores" },
      { "type": "style", "section": "Style" },
      { "type": "revert", "section": "Reverts" }
    ]
  }
}
